import os
os.getenv("GEMINI_API_KEY")


from google import genai


client = genai.Client()


def gemini_llm(content):
    response = client.models.generate_content(
        model = "gemini-3-falsh-preview",
        contents = content
    )
    return response.text


content = input("Enter your prompt")
genimi_llm(context)




import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.naive_bayes import MultinomialNB
from sklearn.feature_extraction.text import TfidfVectorizer, ENGLISH_STOP_WORDS
from sklearn.metrics import classification_report


df = pd.read_csv('movie_review 1.csv')


df.head()


df.isnull().sum()


data = {
    'negative':0,
    'positive': 1,
}
df['review_number'] = df['sentiment'].map(data)


feature = df['review']
target = df['review_number']


ignore_stop_words = {'no','not'}
custom_stop_words = list(set(ENGLISH_STOP_WORDS)-ignore_stop_words)


vectorizer = TfidfVectorizer(
    lowercase = True,
    stop_words = custom_stop_words,
    max_features = 10000, # amx 10000 important vocabulary,
    ngram_range = (1,2)
)


X = vectorizer.fit_transform(feature)


X_train,X_test,Y_train,Y_test = train_test_split(
    X,target,test_size = 0.2 ,random_state = 42
)


model = MultinomialNB()
model.fit(X_train,Y_train)


Y_pred = model.predict(X_test)



cr = classification_report(Y_test,Y_pred)


print(cr)


